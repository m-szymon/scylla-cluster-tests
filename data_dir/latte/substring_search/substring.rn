//! Substring (infix) search workload - schema, load, build_index and search phases.
//!
//! Mirrors data_dir/latte/fts_search/fts.rn: same phases, same -P vocabulary, so that the shared
//! flow in search_perf_test.py drives both. What differs is the index and the query:
//!
//!   fts.rn         CREATE CUSTOM INDEX ... USING 'fulltext_index'
//!                  SELECT ... WHERE BM25(col, :q) > 0 ORDER BY BM25(col, :q) LIMIT n
//!   substring.rn   CREATE CUSTOM INDEX ... USING 'substring_index'
//!                  SELECT ... WHERE col LIKE :pattern LIMIT n
//!
//! An index created with an 'order_by' column answers in that column's order and takes a range on
//! it, so the search phase has three shapes rather than one (see SEARCH_ORDERED/SEARCH_WINDOW_FROM):
//!
//!   plain      WHERE col LIKE :pattern LIMIT n
//!   ordered    WHERE col LIKE :pattern ORDER BY sort DESC LIMIT n
//!   windowed   WHERE col LIKE :pattern AND sort < :cursor ORDER BY sort DESC LIMIT n
//!
//! 'search_direction' turns DESC into ASC (the window then starts from the other end and the
//! bound flips to '>'); 'search_match' turns the '%keyword%' pattern into 'keyword%' or '%keyword'.
//!
//! The LIKE pattern is '%keyword%': the queries file holds bare keywords and this script wraps
//! them, so that a plan can reuse one keyword file at several `search_limit` values. The pattern is
//! bound rather than interpolated, which is also the path a real application takes.
//!
//! Usage:
//!   latte schema             substring.rn <node>
//!   latte schema             substring.rn <node> -P schema_cleanup=true  # full reset
//!   latte schema             substring.rn <node> -P drop_index=true      # drop index only
//!   latte run -f load        substring.rn <node> -d <name_count> \
//!       --threads 1 --concurrency 10
//!   latte run -f build_index substring.rn <node> -d 1
//!   latte run -f search      substring.rn <node> -d 60s --concurrency 32 \
//!       -P 'substring_data_dir="<dir>/"'
//!
//! Schema is idempotent (CREATE TABLE IF NOT EXISTS). Use schema_cleanup=true to drop the table, or
//! drop_index=true to drop just the substring index.

use latte::*;

mod metrics;

// Schema / table
const KEYSPACE = latte::param!("keyspace", "substring_bench");
const TABLE = latte::param!("table", "users");
const INDEX_NAME = latte::param!("index_name", "users_nickname_sub");
const REPLICATION_FACTOR = latte::param!("replication_factor", 1);
const TARGET_COLUMN = latte::param!("target_column", "nickname");
const WITH_INDEX = latte::param!("with_index", false);
const SCHEMA_CLEANUP = latte::param!("schema_cleanup", false);
const DROP_INDEX = latte::param!("drop_index", false);
const MAX_INDEX_WAIT_SECS = latte::param!("max_index_wait_secs", 600);
const MIN_SUCCESSFUL_PROBES = latte::param!("min_successful_probes", 3);
// Number of indexed names. When provided (> 0), indexing throughput is reported alongside index
// build time. Omit or set to 0 to skip throughput.
const NAME_COUNT = latte::param!("name_count", 0);

// Index options, normally set from 'latte_schema_parameters' in the test case -- LatteStressThread
// appends those to every latte invocation, so they reach the CREATE statement issued by the
// build_index phase and not just the one in 'schema'.
//   min_gram/max_gram  the shortest and longest indexed substring, in characters (1..8, min <= max).
//                      0 leaves the option out of the DDL, so the server default applies.
//   case_sensitive     true matches like CQL LIKE does, false folds both the names and the keyword.
//                      Always written out, since what a search box wants (false) is not the default.
const MIN_GRAM = latte::param!("min_gram", 0);
const MAX_GRAM = latte::param!("max_gram", 0);
const CASE_SENSITIVE = latte::param!("case_sensitive", true);
//   order_by   the column the index keeps its matches sorted by. Empty (the default) leaves the
//              option out, and the table has no such column at all, which is the stage-1 shape.
//              Set it and the table gains a bigint column of that name, carrying the third field
//              of the names file, and the index is created to order by it.
const ORDER_BY = latte::param!("order_by", "");
//   extra_option_name / extra_option_value, extra_option2_name / extra_option2_value
//              up to two more entries for the WITH OPTIONS map, for a knob the index node reads and this
//              script has no opinion about (the poc_option_N placeholders). Two plain params rather
//              than a quoted fragment: latte splices a -P value into the script as a literal, so a
//              quote inside it breaks the parse. ScyllaDB rejects a name it does not know.
const EXTRA_OPTION_NAME = latte::param!("extra_option_name", "");
const EXTRA_OPTION_VALUE = latte::param!("extra_option_value", "");
const EXTRA_OPTION2_NAME = latte::param!("extra_option2_name", "");
const EXTRA_OPTION2_VALUE = latte::param!("extra_option2_value", "");

// Search shape. Both are meaningless without ORDER_BY and are rejected below rather than silently
// ignored, since a run that measured the unordered query while its report said 'ordered' would be
// worse than one that failed.
//   search_ordered      add 'ORDER BY <order_by> DESC'.
//   search_window_from  add 'AND <order_by> < :cursor', with the cursor this far into the value
//                       range: 0.0 leaves the window out, 0.5 starts halfway down. This is how a
//                       later page is measured. latte drives no CQL paging, but a page that
//                       resumes at a cursor is exactly a query bounded by it, which is the cost
//                       the cursor was introduced to keep flat.
const SEARCH_ORDERED = latte::param!("search_ordered", false);
const SEARCH_WINDOW_FROM = latte::param!("search_window_from", 0.0);
// "desc" (the default) or "asc": the direction of an ordered or windowed search.
const SEARCH_DIRECTION = latte::param!("search_direction", "desc");
// "contains" (the default), "prefix" or "suffix": where the keyword has to occur.
const SEARCH_MATCH = latte::param!("search_match", "contains");
// The number of distinct sort values, needed to turn 'search_window_from' into a bound. The
// generator numbers them 0..name_count-1, so this is the corpus size.
const SORT_VALUE_COUNT = latte::param!("sort_value_count", 0);

// Dataset files
const SUBSTRING_DATA_DIR = latte::param!("substring_data_dir", "./");
const NAMES_FILE = latte::param!("names_file", "names.tsv");
const QUERIES_FILE = latte::param!("queries_file", "queries_char2.tsv");
const QRELS_FILE = latte::param!("qrels_file", "qrels_char2.tsv");

// Search
const SEARCH_LIMIT = latte::param!("search_limit", 20);
// Off by default: containment is exact, so the interesting numbers here are latency and
// throughput. Turn it on (the flow does when a query set carries 'qrels: true') to check that the
// index still answers correctly under load.
const COMPUTE_ACCURACY = latte::param!("compute_accuracy", false);

// The keyword the build probe searches for. It deliberately need not match anything: the probe
// exists to find out whether the index answers at all, and an unmatched keyword answers with zero
// rows once it does, while an index vector-store has not built yet fails the query outright. Keep
// it at least 'min_gram' characters long, or it is rejected as too short whatever the index state.
const PROBE_KEYWORD = latte::param!("probe_keyword", "zzq");

// Prepared statement names
const INSERT = "insert";
const PROBE = "probe";
const SEARCH = "search";

/// The WITH OPTIONS clause of the CREATE statement.
///
/// Built by concatenation rather than by collecting into a Vec and joining: rune's Vec has no
/// 'join', and reaching for one fails at run time with "Missing instance function for
/// ::std::vec::Vec" rather than when the script is compiled. 'case_sensitive' is emitted last and
/// unconditionally, so every earlier option can carry its own trailing separator.
fn index_options_clause() {
    let opts = "";
    if MIN_GRAM > 0 { opts += `'min_gram': '${MIN_GRAM}', `; }
    if MAX_GRAM > 0 { opts += `'max_gram': '${MAX_GRAM}', `; }
    if is_ordered() { opts += `'order_by': '${ORDER_BY}', `; }
    if EXTRA_OPTION_NAME != "" { opts += `'${EXTRA_OPTION_NAME}': '${EXTRA_OPTION_VALUE}', `; }
    if EXTRA_OPTION2_NAME != "" { opts += `'${EXTRA_OPTION2_NAME}': '${EXTRA_OPTION2_VALUE}', `; }
    opts += `'case_sensitive': '${CASE_SENSITIVE}'`;
    ` WITH OPTIONS = {${opts}}`
}

/// Whether this run indexes with an ordered column.
fn is_ordered() {
    ORDER_BY != ""
}

/// The column list of the table, which gains the sort column only when there is one to gain.
fn table_columns() {
    if is_ordered() {
        `user_id text PRIMARY KEY, ${TARGET_COLUMN} text, ${ORDER_BY} bigint`
    } else {
        `user_id text PRIMARY KEY, ${TARGET_COLUMN} text`
    }
}

/// Create the substring index if absent. Idempotent (IF NOT EXISTS), called from `schema`,
/// `prepare` (load context), or `prepare` (build_index context).
async fn create_index(db) {
    db.execute(`CREATE CUSTOM INDEX IF NOT EXISTS ${INDEX_NAME} ON ${KEYSPACE}.${TABLE}(${TARGET_COLUMN}) USING 'substring_index'${index_options_clause()}`).await?;
    Ok(())
}

pub async fn schema(db) {
    if SCHEMA_CLEANUP {
        db.execute(`DROP TABLE IF EXISTS ${KEYSPACE}.${TABLE}`).await?;
        return;
    }

    db.execute(`CREATE KEYSPACE IF NOT EXISTS ${KEYSPACE} WITH REPLICATION = \
        {'class': 'NetworkTopologyStrategy', 'replication_factor': '${REPLICATION_FACTOR}'}`).await?;
    db.execute(`CREATE TABLE IF NOT EXISTS ${KEYSPACE}.${TABLE} (${table_columns()})`).await?;

    if DROP_INDEX {
        db.execute(`DROP INDEX IF EXISTS ${KEYSPACE}.${INDEX_NAME}`).await?;
    }
    if WITH_INDEX {
        create_index(db).await?;
    }
}

fn join_path(dir, name) {
    if dir == "" || dir.ends_with("/") { dir + name } else { dir + "/" + name }
}

/// The LIKE pattern for a keyword: '%keyword%' for containment, 'keyword%' for a prefix,
/// '%keyword' for a suffix.
fn contains_pattern(keyword) {
    if SEARCH_MATCH == "prefix" {
        `${keyword}%`
    } else if SEARCH_MATCH == "suffix" {
        `%${keyword}`
    } else {
        `%${keyword}%`
    }
}

/// The share of the returned rows that really do contain the keyword.
///
/// Not metrics::precision_at_k, which divides by k: with a LIMIT of 20 and a keyword three names
/// carry, a perfect answer would score 3/20 and read as a failure. Dividing by what was actually
/// returned asks the question worth asking here -- did the index return a row that does not contain
/// the keyword -- which is exactly what a broken verification step after the gram intersection
/// would produce. An empty answer has nothing wrong with it, so it scores 1.0.
fn exact_precision(returned_ids, relevant_ids) {
    if returned_ids.len() == 0 {
        return 1.0;
    }
    let hits = 0;
    for id in returned_ids {
        if relevant_ids.iter().any(|r| r == id) {
            hits += 1;
        }
    }
    hits as f64 / returned_ids.len() as f64
}

pub async fn prepare(db) {
    let has_load = false;
    let has_build_index = false;
    let has_search = false;

    if !is_none(db.data.get("functions_to_invoke")) {
        for item in db.data.functions_to_invoke {
            let name = item.0;
            if name == "load" { has_load = true; }
            if name == "build_index" { has_build_index = true; }
            if name == "search" { has_search = true; }
        }
    } else {
        has_load = true;
    }

    if has_load {
        db.execute(`CREATE KEYSPACE IF NOT EXISTS ${KEYSPACE} WITH REPLICATION = \
            {'class': 'NetworkTopologyStrategy', 'replication_factor': '${REPLICATION_FACTOR}'}`).await?;
        db.execute(`CREATE TABLE IF NOT EXISTS ${KEYSPACE}.${TABLE} (${table_columns()})`).await?;
        if WITH_INDEX {
            create_index(db).await?;
        }

        let path = join_path(SUBSTRING_DATA_DIR, NAMES_FILE);
        let it = fs::read_split_lines_iter(path, ["\t"])?;
        db.data.names = [];
        while let Some(entry) = it.next() {
            let raw = entry?;
            if !raw.is_empty() {
                // The third field is the ordered column's value. A corpus generated before that
                // column existed has only two, so an ordered run against one has to fail here
                // rather than insert nulls -- rows with no sort value are simply missing from an
                // ordered answer, which looks like a recall bug in the index.
                if is_ordered() {
                    if raw.len() < 3 {
                        return Err(`names file ${path} has no sort value column, but order_by=${ORDER_BY} was set; regenerate the corpus with generate_local_dataset.py`);
                    }
                    db.data.names.push(#{ "id": raw[0], "name": raw[1], "sort": raw[2].parse::<i64>()? });
                } else {
                    db.data.names.push(#{ "id": raw[0], "name": raw[1], "sort": 0 });
                }
            }
        }
        db.load_cycle_count = db.data.names.len();
        println!("Loaded {} names from {}", db.data.names.len(), path);
        if is_ordered() {
            db.prepare(INSERT, `INSERT INTO ${KEYSPACE}.${TABLE} (user_id, ${TARGET_COLUMN}, ${ORDER_BY}) VALUES (:user_id, :name, :sort)`).await?;
        } else {
            db.prepare(INSERT, `INSERT INTO ${KEYSPACE}.${TABLE} (user_id, ${TARGET_COLUMN}) VALUES (:user_id, :name)`).await?;
        }
    }

    if has_build_index {
        db.execute(`DROP INDEX IF EXISTS ${KEYSPACE}.${INDEX_NAME}`).await?;
        create_index(db).await?;
        db.data.index_build_start = latte::now_timestamp();
        db.data.index_ready = false;
        db.data.index_ready_elapsed = 0.0;
        db.prepare(PROBE, `SELECT user_id FROM ${KEYSPACE}.${TABLE} WHERE ${TARGET_COLUMN} LIKE :pattern LIMIT 1`).await?;
        db.declare_metric("index_ready_seconds", "lower");
        if NAME_COUNT > 0 {
            db.declare_metric("indexing_throughput_names_per_sec", "higher");
        }
    }

    if has_search {
        let queries_path = join_path(SUBSTRING_DATA_DIR, QUERIES_FILE);
        let it = fs::read_split_lines_iter(queries_path, ["\t"])?;
        db.data.queries = [];
        while let Some(entry) = it.next() {
            let raw = entry?;
            if !raw.is_empty() {
                db.data.queries.push(#{ "id": raw[0], "text": raw[1] });
            }
        }
        println!("Loaded {} keywords from {}", db.data.queries.len(), queries_path);

        if COMPUTE_ACCURACY {
            let qrels_path = join_path(SUBSTRING_DATA_DIR, QRELS_FILE);
            let qit = fs::read_split_lines_iter(qrels_path, ["\t"])?;
            db.data.qrels = [];
            while let Some(entry) = qit.next() {
                let raw = entry?;
                if !raw.is_empty() {
                    db.data.qrels.push(#{ "query_id": raw[0], "user_id": raw[1], "grade": raw[2].parse::<i64>()? });
                }
            }
            println!("Loaded {} qrels from {}", db.data.qrels.len(), qrels_path);

            db.data.qrels_by_query = [];
            for _ in 0..db.data.queries.len() {
                db.data.qrels_by_query.push([]);
            }
            for qrel in db.data.qrels {
                for j in 0..db.data.queries.len() {
                    if db.data.queries[j].id == qrel.query_id {
                        db.data.qrels_by_query[j].push(#{ "user_id": qrel.user_id, "grade": qrel.grade });
                        break;
                    }
                }
            }
            db.data.qrels = [];

            db.declare_metric("recall", "higher");
            db.declare_metric("precision", "higher");
        }

        println!("Search limit: {}", SEARCH_LIMIT);

        // An ordered or windowed shape without a column to order by would quietly run the plain
        // query and report it under the ordered row, which is the one failure here that produces a
        // plausible number for the wrong thing.
        if (SEARCH_ORDERED || SEARCH_WINDOW_FROM > 0.0) && !is_ordered() {
            return Err("search_ordered/search_window_from need an index created with order_by");
        }
        if SEARCH_WINDOW_FROM > 0.0 && SORT_VALUE_COUNT <= 0 {
            return Err("search_window_from needs sort_value_count, the number of distinct sort values");
        }
        if SEARCH_DIRECTION != "desc" && SEARCH_DIRECTION != "asc" {
            return Err("search_direction must be 'desc' or 'asc'");
        }
        if SEARCH_MATCH != "contains" && SEARCH_MATCH != "prefix" && SEARCH_MATCH != "suffix" {
            return Err("search_match must be 'contains', 'prefix' or 'suffix'");
        }
        let ascending = SEARCH_DIRECTION == "asc";

        // The window bound. The generator numbers the sort values 0..count-1 and a descending
        // walk runs downwards, so a cursor at fraction f of the way down is (1 - f) * count:
        // f = 0.5 asks for the page that begins halfway through the order. An ascending walk
        // starts from the other end: the cursor is f * count and the bound is '>'.
        db.data.window_cursor = 0;
        let window_clause = "";
        if SEARCH_WINDOW_FROM > 0.0 {
            if ascending {
                db.data.window_cursor = (SEARCH_WINDOW_FROM * SORT_VALUE_COUNT as f64) as i64;
                window_clause = ` AND ${ORDER_BY} > :cursor`;
                println!("Window: {} > {}", ORDER_BY, db.data.window_cursor);
            } else {
                db.data.window_cursor = ((1.0 - SEARCH_WINDOW_FROM) * SORT_VALUE_COUNT as f64) as i64;
                window_clause = ` AND ${ORDER_BY} < :cursor`;
                println!("Window: {} < {}", ORDER_BY, db.data.window_cursor);
            }
        }
        let order_clause = "";
        if SEARCH_ORDERED {
            if ascending {
                order_clause = ` ORDER BY ${ORDER_BY} ASC`;
            } else {
                order_clause = ` ORDER BY ${ORDER_BY} DESC`;
            }
        }
        db.prepare(SEARCH, `SELECT user_id FROM ${KEYSPACE}.${TABLE} WHERE ${TARGET_COLUMN} LIKE :pattern${window_clause}${order_clause} LIMIT ${SEARCH_LIMIT}`).await?;

        db.set_report_field("dataset", SUBSTRING_DATA_DIR);
        db.set_report_field("queries_file", QUERIES_FILE);
        db.set_report_field("compute_accuracy", `${COMPUTE_ACCURACY}`);
        db.set_report_field("search_ordered", `${SEARCH_ORDERED}`);
        db.set_report_field("search_window_from", `${SEARCH_WINDOW_FROM}`);
        db.set_report_field("search_direction", SEARCH_DIRECTION);
        db.set_report_field("search_match", SEARCH_MATCH);

        db.declare_metric("result_count", "higher");

        db.data.failed_bitmap = [];
        for _ in 0..db.data.queries.len() {
            db.data.failed_bitmap.push(false);
        }
    }
}

pub async fn load(db, i) {
    let row = db.data.names[i % db.data.names.len()];
    if is_ordered() {
        db.execute_prepared(INSERT, #{ "user_id": row.id, "name": row.name, "sort": row.sort }).await?;
    } else {
        db.execute_prepared(INSERT, #{ "user_id": row.id, "name": row.name }).await?;
    }
}

pub async fn build_index(db, i) {
    if db.data.index_ready { // done in warmup
        let elapsed = db.data.index_ready_elapsed;
        db.record_metric("index_ready_seconds", elapsed);
        if NAME_COUNT > 0 && elapsed > 0.0 {
            db.record_metric("indexing_throughput_names_per_sec", NAME_COUNT as f64 / elapsed);
        }
        return Ok(());
    }
    let start = db.data.index_build_start;
    let max_wait = MAX_INDEX_WAIT_SECS;
    let consecutive_ok = 0;
    let streak_start = start;
    let pattern = contains_pattern(PROBE_KEYWORD);
    // NOTE: as in fts.rn, this loop has no pacing of its own -- latte exposes no sleep to rune
    //       scripts. While the index is missing the probe fails and latte's own retry backoff paces
    //       the loop; once the probes start succeeding and the streak is still short it spins as
    //       fast as the DB answers. The probe is a LIMIT 1 containment query for a keyword that
    //       matches nothing, so it is the cheapest question the index can be asked, but it still
    //       lands on the cluster whose build time is being measured.
    loop {
        match db.execute_prepared_with_result(PROBE, #{ "pattern": pattern }).await {
            Ok(_) => {
                if consecutive_ok == 0 {
                    streak_start = latte::now_timestamp();
                }
                consecutive_ok += 1;
                if consecutive_ok >= MIN_SUCCESSFUL_PROBES {
                    let elapsed = (streak_start - start) as f64;
                    db.data.index_ready_elapsed = elapsed;
                    db.data.index_ready = true;
                    db.record_metric("index_ready_seconds", elapsed);
                    if NAME_COUNT > 0 && elapsed > 0.0 {
                        db.record_metric("indexing_throughput_names_per_sec", NAME_COUNT as f64 / elapsed);
                    }
                    return Ok(());
                }
            }
            Err(e) => {
                consecutive_ok = 0;
                let err_msg = format!("{}", e);
                if !(err_msg.contains("QueryRetriesExceeded")
                    && (latte::now_timestamp() - start) < max_wait) {
                    return Err(e);
                }
            }
        }
    }
}

pub async fn search(db, i) {
    if db.data.queries.len() == 0 {
        return Ok(());
    }
    let idx = latte::hash(i) % db.data.queries.len();
    let query = db.data.queries[idx];

    let args = #{ "pattern": contains_pattern(query.text) };
    if SEARCH_WINDOW_FROM > 0.0 {
        args.cursor = db.data.window_cursor;
    }

    match db.execute_prepared_with_result(SEARCH, args).await {
        Err(e) => {
            if !db.data.failed_bitmap[idx] {
                println!("WARNING: query failed [idx={} id=\"{}\" keyword=\"{}\" error={}]",
                         idx, query.id, query.text, e);
                db.data.failed_bitmap[idx] = true;
            }
            return Ok(());
        }
        Ok(rows) => {
            let returned_ids = [];
            for row in rows {
                returned_ids.push(row.user_id);
            }
            db.record_metric("result_count", returned_ids.len() as f64);

            // NOTE: ground truth covers the whole corpus, so it cannot describe a windowed
            //       answer -- the rows below the cursor are correctly absent but count as misses.
            //       A plan that puts 'qrels: true' on a windowed set is asking recall a question it
            //       cannot answer; precision still means what it always did.
            if COMPUTE_ACCURACY {
                let relevant_ids = [];
                for qrel in db.data.qrels_by_query[idx] {
                    if qrel.grade > 0 {
                        relevant_ids.push(qrel.user_id);
                    }
                }
                // Containment has no ranking, so only the set matters. Precision is recorded for
                // every query, including the ones whose answer should be empty -- a keyword nobody
                // carries that still returns rows is exactly the bug worth catching. Recall needs
                // something to recall, so it is recorded only when the ground truth is non-empty,
                // and it is only meaningful while the true answer fits inside SEARCH_LIMIT: see
                // generate_local_dataset.py, which writes ground truth only for such query sets.
                db.record_metric("precision", exact_precision(returned_ids, relevant_ids));
                if relevant_ids.len() > 0 {
                    db.record_metric("recall", metrics::recall_at_k(returned_ids, relevant_ids, SEARCH_LIMIT));
                }
            }
        }
    }
    Ok(())
}
